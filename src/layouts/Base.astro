---
interface Props {
  title: string
  description: string
  noindex?: boolean
}
const { title, description, noindex = false } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '') || Astro.site
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <slot name="head" />
    <style is:global>
      :root {
        --navy: #12314e; --teal: #0e7490; --teal-dark: #155e75;
        --bg: #f8fafc; --card: #ffffff; --text: #1e293b; --muted: #64748b;
        --border: #e2e8f0; --gold: #b45309; --green: #047857;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; background: var(--bg); color: var(--text); line-height: 1.6; }
      a { color: var(--teal); }
      .wrap { max-width: 880px; margin: 0 auto; padding: 0 1rem; }
      header.site { background: var(--navy); color: #fff; padding: 0.9rem 0; }
      header.site .wrap { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
      .logo { color: #fff; text-decoration: none; font-weight: 800; font-size: 1.15rem; letter-spacing: -0.01em; }
      .logo span { color: #67e8f9; }
      nav.site a { color: #cbd5e1; text-decoration: none; margin-left: 1rem; font-size: 0.95rem; }
      nav.site a:hover { color: #fff; }
      main { padding: 2rem 0 3rem; }
      h1 { font-size: 1.7rem; line-height: 1.3; color: var(--navy); margin-bottom: 0.5rem; }
      h2 { font-size: 1.2rem; color: var(--navy); margin: 1.5rem 0 0.5rem; }
      .card { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 1.1rem 1.25rem; margin-bottom: 0.8rem; }
      .job-row { display: block; text-decoration: none; color: inherit; }
      .job-row:hover { border-color: var(--teal); }
      .job-row h3 { font-size: 1.02rem; color: var(--teal-dark); margin-bottom: 0.15rem; }
      .meta { font-size: 0.88rem; color: var(--muted); }
      .badge { display: inline-block; font-size: 0.75rem; font-weight: 600; padding: 0.1rem 0.55rem; border-radius: 99px; margin-right: 0.4rem; vertical-align: 1px; }
      .badge.remote { background: #ecfdf5; color: var(--green); }
      .badge.telework { background: #fffbeb; color: var(--gold); }
      .badge.contractor { background: #eff6ff; color: #1d4ed8; }
      .badge.federal { background: #f1f5f9; color: var(--navy); }
      .btn { display: inline-block; background: var(--teal); color: #fff; text-decoration: none; font-weight: 700; padding: 0.7rem 1.4rem; border-radius: 8px; }
      .btn:hover { background: var(--teal-dark); }
      .facts { display: grid; grid-template-columns: max-content 1fr; gap: 0.3rem 1.2rem; font-size: 0.95rem; }
      .facts dt { color: var(--muted); }
      .facts dd { font-weight: 600; }
      .description h2 { font-size: 1.05rem; margin-top: 1.4rem; }
      .description p { margin: 0.6rem 0; }
      .description ul { margin: 0.6rem 0 0.6rem 1.4rem; }
      footer.site { border-top: 1px solid var(--border); padding: 1.5rem 0 2.5rem; font-size: 0.85rem; color: var(--muted); }
      footer.site a { color: var(--muted); }
      .resume-check textarea { width: 100%; min-height: 160px; padding: 0.75rem; border: 1px solid var(--border); border-radius: 8px; font-family: inherit; font-size: 0.95rem; resize: vertical; margin: 0.75rem 0; }
      .resume-check .btn { margin-bottom: 0.5rem; border: none; cursor: pointer; font-size: 1rem; }
      .kw-wrap { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.5rem 0 1rem; }
      .kw-chip { display: inline-block; font-size: 0.85rem; padding: 0.25rem 0.65rem; border-radius: 99px; }
      .kw-chip.kw-found { background: #ecfdf5; color: var(--green); }
      .kw-chip.kw-missing { background: #fef2f2; color: #b91c1c; }
      .resume-score { font-weight: 700; font-size: 1.05rem; color: var(--navy); margin-bottom: 0.5rem; }
      .resume-check h3 { font-size: 0.95rem; margin-top: 1rem; }
      .resume-check ul { margin: 0.5rem 0 0 1.2rem; }
      .resume-check ul li { margin-bottom: 0.4rem; }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="logo" href="/">GovRemote<span>Jobs</span></a>
        <nav class="site">
          <a href="/remote">Fully Remote</a>
          <a href="/telework">Telework</a>
          <a href="/agencies">Agencies</a>
          <a href="/companies">Contractors</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site">
      <div class="wrap">
        <p><strong>GovRemoteJobs</strong> lists remote and telework-eligible US government and federal contractor jobs, refreshed daily from official sources. Every listing links to the original posting — apply there.</p>
        <p style="margin-top:0.5rem;">Not affiliated with the US government, USAJOBS, or any listed employer. Federal listing data via the official USAJOBS API.</p>
        <p style="margin-top:1rem;"><a href="/about">About</a> · <a href="/contact">Contact</a> · <a href="/privacy">Privacy Policy</a> · <a href="/terms">Terms of Service</a></p>
      </div>
    </footer>
  </body>
</html>
