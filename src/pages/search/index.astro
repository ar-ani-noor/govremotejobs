---
import Base from '../../layouts/Base.astro'
---
<Base title="Search Jobs — GovRemoteJobs" description="Search and filter remote and telework-eligible US government and federal contractor jobs." noindex={true}>
  <h1>Search Jobs</h1>
  <p class="meta" style="margin-bottom:1.5rem;">Search by title, agency, or company, then narrow with filters.</p>

  <div class="search-layout">
    <aside class="search-filters">
      <div class="filter-group">
        <h3>Work Location</h3>
        <div id="filter-location"></div>
      </div>
      <div class="filter-group">
        <h3>Employer Type</h3>
        <div id="filter-type"></div>
      </div>
      <div class="filter-group">
        <h3>Category</h3>
        <div id="filter-category" class="filter-scroll"></div>
      </div>
      <div class="filter-group">
        <h3>Agency / Company</h3>
        <div id="filter-employer" class="filter-scroll"></div>
      </div>
      <div class="filter-group">
        <h3>Salary</h3>
        <label class="salary-label">Min <input type="number" id="salary-min" min="0" step="1000" placeholder="0" /></label>
        <label class="salary-label">Max <input type="number" id="salary-max" min="0" step="1000" placeholder="No max" /></label>
        <p class="meta" style="font-size:0.78rem;margin-top:0.35rem;">Hourly pay is compared as an annual figure (× 2,087 hours).</p>
      </div>
    </aside>
    <div class="search-results" id="results">
      <p class="meta">Loading jobs…</p>
    </div>
  </div>

  <style>
    .search-layout { display: grid; grid-template-columns: 220px 1fr; gap: 1.5rem; margin-top: 1rem; }
    .filter-group { margin-bottom: 1.25rem; }
    .filter-group h3 { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.03em; color: var(--muted); margin-bottom: 0.5rem; }
    /* :global() on every selector below that targets a node this page builds in
       JS. Astro scopes styles with a [data-astro-cid-*] attribute it can only
       stamp onto elements present in the template, so scoped rules never match
       createElement()'d nodes — .filter-option labels were silently unstyled
       (inline, not one-per-line). These class names appear nowhere else. */
    :global(.filter-option) { display: block; font-size: 0.9rem; margin-bottom: 0.35rem; cursor: pointer; }
    :global(.filter-option input) { margin-right: 0.4rem; }
    /* Category (261 values) and Agency/Company (277 values) would otherwise
       render a ~15,000px-tall sidebar. Counts are sorted descending, so the
       useful options sit above the fold of this box. */
    .filter-scroll { max-height: 260px; overflow-y: auto; overscroll-behavior: contain; border: 1px solid var(--border); border-radius: 6px; padding: 0.45rem 0.55rem; background: var(--card); }
    :global(.filter-option.is-empty) { opacity: 0.5; }
    .salary-label { display: block; font-size: 0.85rem; margin-bottom: 0.4rem; }
    .salary-label input { width: 100%; padding: 0.3rem 0.5rem; border: 1px solid var(--border); border-radius: 6px; margin-top: 0.2rem; }
    :global(.result-count) { margin-bottom: 0.75rem; }
    :global(.load-more) { border: none; cursor: pointer; font-size: 0.95rem; margin-top: 0.5rem; }
    :global(.load-more[disabled]) { opacity: 0.6; cursor: default; }
    @media (max-width: 640px) { .search-layout { grid-template-columns: 1fr; } }
  </style>

  <script>
    import { tierLabel, typeLabel } from '../../lib/format.ts'

    type FilterCounts = Record<string, Record<string, number>>

    // Render 20 results at a time. Rendering the unbounded set froze the tab for
    // 10-20s and pulled ~9.7MB of fragments on a single "Federal" click.
    const PAGE_SIZE = 20
    // How many results to inspect per page when a salary range is set. The
    // salary bound lives in Pagefind meta, not in the index, so it can only be
    // applied to fetched fragments — this caps the work per click when very few
    // results match the range.
    const SCAN_LIMIT = 200
    const DEBOUNCE_MS = 250

    const FILTER_GROUPS = [
      { containerId: 'filter-location', key: 'location' },
      { containerId: 'filter-type', key: 'type' },
      { containerId: 'filter-category', key: 'category' },
      { containerId: 'filter-employer', key: 'employer' },
    ]

    let pagefindPromise: Promise<any> | null = null
    let baseFilterCounts: FilterCounts = {}
    const activeFilters: Record<string, string[]> = {}
    let salaryMin: number | null = null
    let salaryMax: number | null = null

    // Monotonic token: every search increments it, and every async continuation
    // re-checks it, so a slow early keystroke can never overwrite a later one.
    let requestToken = 0
    let allResults: any[] = []
    let pending: any[] = [] // fetched + salary-matching, not yet rendered
    let cursor = 0 // how far into allResults we have fetched
    let shown = 0

    function loadPagefind(): Promise<any> {
      if (!pagefindPromise) {
        pagefindPromise = (async () => {
          // @ts-ignore -- generated at build time by `npx pagefind`, not present in dev.
          // Hidden from Vite's static import analysis via Function() indirection — a
          // plain `import('/pagefind/pagefind.js')` gets wrapped in Vite's
          // __vitePreload() helper, which throws `__VITE_PRELOAD__ is not defined`
          // because this path doesn't exist until Pagefind's build step runs, after
          // Vite's analysis pass.
          const dynamicImport = new Function('specifier', 'return import(specifier)')
          const pf = await dynamicImport('/pagefind/pagefind.js')
          await pf.init()
          // Loading the full filter list once seeds the sidebar before the first
          // search AND is what makes Pagefind return per-search filter counts on
          // every later search() call.
          baseFilterCounts = (await pf.filters()) ?? {}
          return pf
        })().catch((err) => {
          pagefindPromise = null // let a later interaction retry
          throw err
        })
      }
      return pagefindPromise
    }

    /* ---------- filters ---------- */

    function renderFilters(counts: FilterCounts) {
      for (const group of FILTER_GROUPS) {
        renderFilterGroup(group.containerId, group.key, counts[group.key] ?? {})
      }
    }

    function renderFilterGroup(containerId: string, filterKey: string, values: Record<string, number>) {
      const container = document.getElementById(containerId)
      if (!container) return
      const checked = new Set(activeFilters[filterKey] ?? [])

      // Re-rendering blows away focus and scroll position; a keyboard user
      // tabbing through 277 agencies would lose their place on every change.
      const focused = document.activeElement as HTMLElement | null
      const refocus =
        focused && focused.dataset && focused.dataset.filterKey === filterKey
          ? focused.dataset.filterValue ?? null
          : null
      const scrollTop = container.scrollTop

      const entries = Object.entries(values).sort((a, b) => {
        // Checked values stay pinned at the top so the box you just clicked
        // doesn't jump; everything else is most-results-first.
        const aChecked = checked.has(a[0]) ? 1 : 0
        const bChecked = checked.has(b[0]) ? 1 : 0
        if (aChecked !== bChecked) return bChecked - aChecked
        if (b[1] !== a[1]) return b[1] - a[1]
        return a[0].localeCompare(b[0])
      })

      container.innerHTML = ''
      if (entries.length === 0) {
        const empty = document.createElement('p')
        empty.className = 'meta'
        empty.textContent = 'No options'
        container.appendChild(empty)
        return
      }

      const frag = document.createDocumentFragment()
      for (const [value, count] of entries) {
        const label = document.createElement('label')
        label.className = count === 0 ? 'filter-option is-empty' : 'filter-option'
        const checkbox = document.createElement('input')
        checkbox.type = 'checkbox'
        checkbox.checked = checked.has(value)
        checkbox.dataset.filterKey = filterKey
        checkbox.dataset.filterValue = value
        checkbox.addEventListener('change', () => {
          const current = new Set(activeFilters[filterKey] ?? [])
          if (checkbox.checked) current.add(value)
          else current.delete(value)
          activeFilters[filterKey] = [...current]
          runSearchNow()
        })
        label.appendChild(checkbox)
        const text = filterKey === 'location' ? tierLabel(value) : filterKey === 'type' ? typeLabel(value) : value
        label.appendChild(document.createTextNode(` ${text} (${count.toLocaleString()})`))
        frag.appendChild(label)
      }
      container.appendChild(frag)
      container.scrollTop = scrollTop

      if (refocus !== null) {
        const escaped = typeof CSS !== 'undefined' && CSS.escape ? CSS.escape(refocus) : refocus.replace(/"/g, '\\"')
        const next = container.querySelector(`input[data-filter-value="${escaped}"]`) as HTMLInputElement | null
        next?.focus()
      }
    }

    /* ---------- results ---------- */

    function resultsContainer(): HTMLElement | null {
      return document.getElementById('results')
    }

    function showMessage(html: string) {
      const container = resultsContainer()
      if (container) container.innerHTML = html
    }

    function showSearching() {
      showMessage('<p class="meta">Searching…</p>')
    }

    function showError() {
      showMessage(
        '<p class="meta">Search is temporarily unavailable — browse <a href="/remote">Fully Remote</a> or <a href="/telework">Telework</a> jobs instead.</p>'
      )
    }

    function salaryActive(): boolean {
      return salaryMin !== null || salaryMax !== null
    }

    function matchesSalary(item: any): boolean {
      if (!salaryActive()) return true
      const rawMin = Number(item.meta?.salary_min)
      const rawMax = Number(item.meta?.salary_max)
      const min = Number.isFinite(rawMin) ? rawMin : null
      const max = Number.isFinite(rawMax) ? rawMax : null
      // Exclude only when the job's published range provably misses the user's:
      // an unknown bound is never grounds for exclusion, so partial-salary jobs
      // (and jobs with no salary at all) always pass the side they don't publish.
      if (salaryMin !== null && max !== null && max < salaryMin) return false
      if (salaryMax !== null && min !== null && min > salaryMax) return false
      return true
    }

    function hasMore(): boolean {
      return pending.length > 0 || cursor < allResults.length
    }

    // Fetches forward through allResults until PAGE_SIZE salary-matching items
    // are buffered (or the results / scan budget run out). Returns null if a
    // newer search started while we were awaiting.
    async function collectPage(token: number): Promise<any[] | null> {
      let scanned = 0
      while (pending.length < PAGE_SIZE && cursor < allResults.length && scanned < SCAN_LIMIT) {
        const batch = allResults.slice(cursor, cursor + PAGE_SIZE)
        cursor += batch.length
        scanned += batch.length
        const items = await Promise.all(batch.map((r: any) => r.data()))
        if (token !== requestToken) return null
        for (const item of items) if (matchesSalary(item)) pending.push(item)
      }
      return pending.splice(0, PAGE_SIZE)
    }

    function buildShell(): HTMLElement | null {
      const container = resultsContainer()
      if (!container) return null
      container.innerHTML = ''
      const count = document.createElement('p')
      count.className = 'meta result-count'
      count.id = 'result-count'
      const list = document.createElement('div')
      list.id = 'result-list'
      container.appendChild(count)
      container.appendChild(list)
      return list
    }

    function appendCards(list: HTMLElement, items: any[]) {
      const frag = document.createDocumentFragment()
      for (const item of items) {
        // Pagefind indexes with a trailing slash, but trailingSlash:'never' only
        // serves the no-slash form.
        const url = String(item.url ?? '').replace(/\/$/, '')
        const card = document.createElement('a')
        card.className = 'job-row card'
        card.href = url || '/'

        // Each fragment ships the page's own filter values — reuse them for the
        // same badge row job pages render, instead of letting page furniture
        // leak into the excerpt.
        const location = item.filters?.location?.[0]
        const type = item.filters?.type?.[0]
        if (location || type) {
          const badges = document.createElement('p')
          badges.className = 'meta'
          badges.style.marginBottom = '0.15rem'
          if (location) {
            const b = document.createElement('span')
            b.className = `badge ${location}`
            b.textContent = tierLabel(location)
            badges.appendChild(b)
          }
          if (type) {
            const b = document.createElement('span')
            b.className = `badge ${type}`
            b.textContent = typeLabel(type)
            badges.appendChild(b)
          }
          card.appendChild(badges)
        }

        const title = document.createElement('h3')
        title.textContent = item.meta?.title ?? url // textContent, so titles with & or < can't break the markup
        card.appendChild(title)

        const factsBits = [
          item.filters?.employer?.[0],
          item.meta?.salary,
          item.meta?.posted ? `Posted ${item.meta.posted}` : null,
        ].filter(Boolean)
        if (factsBits.length) {
          const facts = document.createElement('p')
          facts.className = 'meta'
          facts.style.marginBottom = '0.35rem'
          facts.textContent = factsBits.join(' · ')
          card.appendChild(facts)
        }

        const excerpt = document.createElement('p')
        excerpt.className = 'meta'
        excerpt.innerHTML = item.excerpt ?? '' // Pagefind-generated HTML (<mark> highlights)
        card.appendChild(excerpt)
        frag.appendChild(card)
      }
      list.appendChild(frag)
    }

    function updateCount() {
      const el = document.getElementById('result-count')
      if (!el) return
      const total = allResults.length
      const jobs = (n: number) => `${n.toLocaleString()} job${n === 1 ? '' : 's'}`
      if (shown === 0) {
        el.textContent =
          total === 0
            ? 'No jobs match your search and filters.'
            : hasMore()
              ? `No jobs in the first ${cursor.toLocaleString()} matches fit your salary range — load more to keep looking.`
              : 'No jobs match your search, filters, and salary range.'
        return
      }
      if (!salaryActive()) {
        el.textContent = hasMore() ? `${jobs(total)} found — showing first ${shown.toLocaleString()}` : `${jobs(total)} found`
        return
      }
      // With a salary range set, the true total is unknowable without fetching
      // every fragment — say exactly how far we have looked instead of implying it.
      el.textContent = hasMore()
        ? `${jobs(shown)} in your salary range, from the first ${cursor.toLocaleString()} of ${total.toLocaleString()} matches`
        : `${jobs(shown)} in your salary range`
    }

    function updateLoadMore(token: number) {
      const container = resultsContainer()
      const existing = document.getElementById('load-more') as HTMLButtonElement | null
      if (!hasMore()) {
        existing?.remove()
        return
      }
      const button = existing ?? document.createElement('button')
      if (!existing) {
        button.id = 'load-more'
        button.type = 'button'
        button.className = 'btn load-more'
        button.addEventListener('click', () => loadMore(token))
        container?.appendChild(button)
      }
      button.disabled = false
      button.textContent = 'Load more'
    }

    // Pagefind memoizes every fragment load promise, rejections included
    // (loaded_fragments[hash] in its runtime), so once a fetch fails during a
    // network blip, re-requesting the same fragments fails forever on the same
    // instance. Real recovery needs pf.destroy() + a fresh search.
    let recoverOnRetry = false

    async function loadMore(token: number) {
      if (token !== requestToken) return
      if (recoverOnRetry) {
        recoverOnRetry = false
        try {
          const pf = await pagefindPromise
          await pf?.destroy?.()
        } catch {
          // a broken instance is being thrown away either way
        }
        pagefindPromise = null
        runSearchNow()
        return
      }
      const button = document.getElementById('load-more') as HTMLButtonElement | null
      if (button) {
        button.disabled = true
        button.textContent = 'Loading…'
      }
      // Snapshot paging state so a mid-fetch failure can roll back cleanly —
      // otherwise a retry would skip the failed batch (cursor already advanced)
      // or duplicate items already buffered in pending.
      const prevCursor = cursor
      const prevPending = pending.slice()
      try {
        const page = await collectPage(token)
        if (page === null || token !== requestToken) return
        const list = document.getElementById('result-list')
        if (!list) return
        appendCards(list, page)
        shown += page.length
        updateCount()
        updateLoadMore(token)
      } catch (err) {
        // One failed page fetch must not wipe the results the user already has
        // (showError() replaces all of #results) — recover inline on the button.
        console.error('[search] Failed to load more results', err)
        if (token !== requestToken) return
        cursor = prevCursor
        pending = prevPending
        recoverOnRetry = true
        const btn = document.getElementById('load-more') as HTMLButtonElement | null
        if (btn) {
          btn.disabled = false
          btn.textContent = 'Couldn’t load more — try again'
        }
      }
    }

    /* ---------- search ---------- */

    async function runSearch() {
      const token = ++requestToken // invalidates any in-flight search or "Load more"
      const input = document.getElementById('search-input-page') as HTMLInputElement | null
      const query = (input?.value ?? '').trim()

      // Keep ?q= in sync so refresh/back/share reflect the query actually shown,
      // not the one the page happened to load with. replaceState, not pushState:
      // typing shouldn't grow the history stack.
      history.replaceState(null, '', query ? `?q=${encodeURIComponent(query)}` : window.location.pathname)

      // No query and no filters is a valid state: browse-all. pf.search(null, {})
      // returns the whole index, so the page always shows jobs instead of an
      // empty prompt waiting for input.
      showSearching()
      try {
        const pf = await loadPagefind()
        if (token !== requestToken) return
        // Pagefind ANDs plain array values within one filter key, and every job
        // has exactly one location/type/category/employer — two checked boxes in
        // the same group would return zero results. { any: [...] } gives the
        // union a checkbox UI implies.
        const filtersArg: Record<string, { any: string[] }> = {}
        for (const [key, values] of Object.entries(activeFilters)) {
          if (values.length > 0) filtersArg[key] = { any: values }
        }
        const search = await pf.search(query || null, { filters: filtersArg })
        if (token !== requestToken) return

        // search.filters is scoped to this result set ("how many results if I
        // also check this") — right for untouched groups, but inside a group
        // with a selection it reports every sibling as 0. For refined groups,
        // sibling counts come from a supplementary search that omits that
        // group's own filter (classic faceted-search behavior). Not
        // search.totalFilters: it returns all zeros for filter-only (null-term)
        // searches, verified empirically against this site's built index.
        const refinedKeys = FILTER_GROUPS.filter((g) => (activeFilters[g.key] ?? []).length > 0).map((g) => g.key)
        const supplementary = await Promise.all(
          refinedKeys.map(async (key) => {
            const others: Record<string, { any: string[] }> = {}
            for (const [k, values] of Object.entries(activeFilters)) {
              if (k !== key && values.length > 0) others[k] = { any: values }
            }
            const s = await pf.search(query || null, { filters: others })
            return [key, s.filters?.[key] ?? {}] as const
          })
        )
        if (token !== requestToken) return
        const supplementaryCounts = new Map(supplementary)
        const counts: FilterCounts = {}
        for (const group of FILTER_GROUPS) {
          counts[group.key] =
            supplementaryCounts.get(group.key) ?? search.filters?.[group.key] ?? baseFilterCounts[group.key] ?? {}
        }
        renderFilters(counts)

        allResults = search.results ?? []
        pending = []
        cursor = 0
        shown = 0
        const list = buildShell()
        if (!list) return
        const page = await collectPage(token)
        if (page === null || token !== requestToken) return
        appendCards(list, page)
        shown = page.length
        updateCount()
        updateLoadMore(token)
      } catch (err) {
        console.error('[search] Search failed', err)
        if (token === requestToken) showError()
      }
    }

    let debounceTimer: number | undefined

    function scheduleSearch() {
      if (debounceTimer !== undefined) clearTimeout(debounceTimer)
      debounceTimer = window.setTimeout(() => {
        debounceTimer = undefined
        runSearch()
      }, DEBOUNCE_MS)
    }

    function runSearchNow() {
      if (debounceTimer !== undefined) {
        clearTimeout(debounceTimer)
        debounceTimer = undefined
      }
      runSearch()
    }

    document.addEventListener('DOMContentLoaded', () => {
      const params = new URLSearchParams(window.location.search)
      const q = params.get('q') ?? ''

      // The header SearchBar already navigated here with ?q=..., but this
      // page has no visible input of its own beyond the header's — reuse it.
      const headerInput = document.querySelector('.header-search input[type="search"]') as HTMLInputElement | null
      if (headerInput) {
        headerInput.id = 'search-input-page'
        headerInput.value = q // client-side URL read — Astro.url.searchParams is meaningless in a static build
        headerInput.closest('form')?.addEventListener('submit', (e) => {
          e.preventDefault()
          runSearchNow()
        })
        headerInput.addEventListener('input', () => scheduleSearch())
      }

      const minInput = document.getElementById('salary-min') as HTMLInputElement
      const maxInput = document.getElementById('salary-max') as HTMLInputElement
      minInput?.addEventListener('input', () => {
        salaryMin = minInput.value ? Number(minInput.value) : null
        scheduleSearch()
      })
      maxInput?.addEventListener('input', () => {
        salaryMax = maxInput.value ? Number(maxInput.value) : null
        scheduleSearch()
      })

      // Always search on load — with no ?q= this is browse-all, so the page
      // opens showing jobs rather than waiting for input.
      runSearchNow()
    })
  </script>
</Base>
