---
import Base from '../layouts/Base.astro'
import { activeJobs, kebab } from '../lib/db.ts'
const jobs = (await activeJobs()).filter((j) => j.category_name)
const counts = new Map<string, number>()
for (const j of jobs) counts.set(j.category_name!, (counts.get(j.category_name!) ?? 0) + 1)
const rows = [...counts.entries()].sort((a, b) => b[1] - a[1])
---
<Base title="Job Categories" description={`Browse ${jobs.length} remote and telework government jobs by category, updated daily.`}>
  <h1>Browse by category</h1>
  {rows.map(([name, n]) => (
    <a class="card job-row" href={`/category/${kebab(name)}`}><h3>{name}</h3><div class="meta">{n} open position{n === 1 ? '' : 's'}</div></a>
  ))}
</Base>
