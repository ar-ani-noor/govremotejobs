---
import Base from '../layouts/Base.astro'
import JobList from '../components/JobList.astro'
import AdSlot from '../components/AdSlot.astro'
import { activeJobs } from '../lib/db.ts'

const jobs = await activeJobs()
const remote = jobs.filter((j) => j.location_policy === 'remote')
const telework = jobs.filter((j) => j.location_policy === 'telework')
const latest = jobs.slice(0, 20)
const count = jobs.length.toLocaleString('en-US')
---
<Base
  title="GovRemoteJobs — Remote Government & Federal Contractor Jobs"
  description={`${jobs.length} remote and telework-eligible US government and federal contractor jobs, updated daily from official sources. Every listing links to the original posting.`}
  hideSearch={true}
>
  <div class="poster">
    <p class="poster-eyebrow">Remote &amp; telework-eligible federal jobs</p>
    <h1 class="poster-headline">Serve from<br /><span>anywhere.</span></h1>
    <p class="poster-sub">
      {count} remote and telework-eligible federal and contractor positions, gathered
      every morning from official sources. Every listing links to the original posting.
    </p>
    <form class="poster-search" action="/search" method="get" role="search">
      <input type="search" name="q" placeholder="Search title, agency, or company…" aria-label="Search jobs" />
      <button type="submit">Search</button>
    </form>
    <svg viewBox="0 0 800 260" class="poster-scene" role="img" aria-label="Evening sky over a homestead">
      <rect x="0" y="0" width="800" height="260" fill="#2e4560"></rect>
      <g>
        <path d="M400 150 L400 30" stroke="#e0b64f" stroke-width="7"></path>
        <path d="M400 150 L310 55" stroke="#e0b64f" stroke-width="6"></path>
        <path d="M400 150 L490 55" stroke="#e0b64f" stroke-width="6"></path>
        <path d="M400 150 L250 95" stroke="#e0b64f" stroke-width="5"></path>
        <path d="M400 150 L550 95" stroke="#e0b64f" stroke-width="5"></path>
        <path d="M400 150 L215 145" stroke="#e0b64f" stroke-width="4"></path>
        <path d="M400 150 L585 145" stroke="#e0b64f" stroke-width="4"></path>
      </g>
      <circle cx="400" cy="150" r="64" fill="#e0b64f"></circle>
      <path d="M0 190 Q 200 150 420 185 T 800 175 L 800 260 L 0 260 Z" fill="#16243a"></path>
      <path d="M0 215 Q 260 185 520 212 T 800 205 L 800 260 L 0 260 Z" fill="#0f1a2b"></path>
      <g>
        <rect x="352" y="158" width="96" height="52" fill="#0f1a2b"></rect>
        <path d="M340 160 L400 118 L460 160 Z" fill="#0f1a2b"></path>
        <rect x="386" y="176" width="20" height="24" fill="#e0b64f"></rect>
        <rect x="470" y="96" width="4" height="72" fill="#0f1a2b"></rect>
        <path d="M474 96 L510 104 L474 114 Z" fill="#cf5b3f"></path>
      </g>
    </svg>
    <div class="poster-imprint">
      <span>Updated every morning</span><span>Official sources only</span><span>{count} open positions</span>
    </div>
  </div>

  <div class="stat-tiles">
    <a class="tile tile-paper" href="/remote"><div class="tile-n">{remote.length.toLocaleString('en-US')}</div><div class="tile-l">Fully remote</div></a>
    <a class="tile tile-gold" href="/telework"><div class="tile-n">{telework.length.toLocaleString('en-US')}</div><div class="tile-l">Telework eligible</div></a>
    <a class="tile tile-line" href="/companies"><div class="tile-n">{jobs.filter((j) => j.employer_type === 'contractor').length.toLocaleString('en-US')}</div><div class="tile-l">Contractor roles</div></a>
  </div>

  <AdSlot slot="leaderboard" />

  <h2 class="rule-heading"><span>Latest postings</span></h2>
  <JobList jobs={latest} />
  <p><a href="/remote">Browse all fully remote →</a> · <a href="/telework">all telework →</a></p>

  <style>
    .poster { background: var(--paper); border: 3px solid var(--ink); box-shadow: inset 0 0 0 6px var(--paper), inset 0 0 0 7px var(--ink); padding: 2.6rem 2.6rem 0 2.6rem; display: flex; flex-direction: column; gap: 1.2rem; text-align: center; }
    .poster-eyebrow { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted-paper); }
    .poster-headline { font-size: clamp(2.6rem, 8vw, 4.4rem); line-height: 0.95; color: var(--ink); margin: 0; }
    .poster-headline span { color: var(--coral); }
    .poster-sub { font-size: 0.97rem; color: var(--muted-paper); max-width: 560px; margin: 0 auto; line-height: 1.6; }
    .poster-search { display: flex; gap: 0.6rem; max-width: 620px; width: 100%; margin: 0 auto; }
    .poster-search input { flex: 1; min-width: 0; background: #ffffff; border: 2px solid var(--ink); padding: 0.7rem 1rem; font-size: 0.95rem; font-family: inherit; color: var(--ink); }
    .poster-search input::placeholder { color: #9b9787; }
    .poster-search button { background: var(--coral); color: var(--paper); border: none; padding: 0.7rem 1.6rem; font-size: 0.95rem; font-weight: 700; cursor: pointer; font-family: inherit; }
    .poster-search button:hover { background: var(--coral-dark); }
    .poster-scene { width: 100%; display: block; margin-top: 0.4rem; }
    .poster-imprint { border-top: 1px solid var(--ink); margin: 0 -2.6rem; padding: 0.6rem 2.6rem; display: flex; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap; font-family: 'Spline Sans Mono', ui-monospace, monospace; font-size: 0.65rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted-paper); }
    .stat-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.9rem; margin: 1.5rem 0; }
    .tile { text-decoration: none; padding: 1.1rem 1.25rem; display: flex; flex-direction: column; gap: 0.1rem; }
    .tile-n { font-family: 'Staatliches', 'Arial Narrow', sans-serif; font-size: 2.1rem; line-height: 1; }
    .tile-l { font-family: 'Spline Sans Mono', ui-monospace, monospace; font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; }
    .tile-paper { background: var(--paper); color: var(--ink); }
    .tile-paper .tile-l { color: var(--muted-paper); }
    .tile-gold { background: var(--gold); color: var(--ink); }
    .tile-gold .tile-l { color: #4a3a10; }
    .tile-line { background: transparent; border: 2px solid var(--paper); color: var(--paper); }
    .tile-line .tile-l { color: var(--light); }
    .rule-heading { display: flex; align-items: baseline; gap: 0.8rem; }
    .rule-heading::after { content: ''; flex: 1; border-bottom: 2px solid var(--paper); }
    @media (max-width: 640px) { .poster { padding: 1.6rem 1.2rem 0 1.2rem; } .poster-imprint { margin: 0 -1.2rem; padding: 0.6rem 1.2rem; } }
  </style>
</Base>
