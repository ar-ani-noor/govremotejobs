---
import Base from '../layouts/Base.astro'
import JobList from '../components/JobList.astro'
import { activeJobs } from '../lib/db.ts'

const jobs = await activeJobs()
const remote = jobs.filter((j) => j.location_policy === 'remote')
const telework = jobs.filter((j) => j.location_policy === 'telework')
const federalRemote = remote.filter((j) => j.employer_type === 'federal')
const latest = jobs.slice(0, 20)
const today = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
---
<Base
  title="GovRemoteJobs — Remote Government & Federal Contractor Jobs"
  description={`${jobs.length} remote and telework-eligible US government and federal contractor jobs, updated daily from official sources. Every listing links to the original posting.`}
>
  <h1>Remote government &amp; contractor jobs, updated daily</h1>
  <p style="color:var(--muted);max-width:620px;">
    {jobs.length} open positions from official sources — the USAJOBS federal API and
    contractors' own career feeds. As of {today}. Every listing links to the original posting.
  </p>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:0.8rem;margin:1.5rem 0;">
    <a class="card job-row" href="/remote"><h3>{remote.length}</h3><div class="meta">Fully remote jobs</div></a>
    <a class="card job-row" href="/telework"><h3>{telework.length}</h3><div class="meta">Telework-eligible jobs</div></a>
    <a class="card job-row" href="/remote#federal"><h3>{federalRemote.length}</h3><div class="meta">Fully remote federal jobs — every one that exists</div></a>
  </div>

  <h2>Latest postings</h2>
  <JobList jobs={latest} />
  <p><a href="/remote">Browse all fully remote →</a> · <a href="/telework">all telework →</a></p>
</Base>
