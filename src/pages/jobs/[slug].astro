---
import Base from '../../layouts/Base.astro'
import { activeJobs, kebab } from '../../lib/db.ts'
import { salaryText, dateText, tierLabel, applyLabel, sourceLabel } from '../../lib/format.ts'
import { jobPostingJsonLd } from '../../lib/jsonld.ts'
import { extractKeywords } from '../../lib/resume-match.ts'
import AdSlot from '../../components/AdSlot.astro'

export async function getStaticPaths() {
  const jobs = await activeJobs()
  return jobs.map((job) => ({ params: { slug: job.slug }, props: { job } }))
}
const { job } = Astro.props
const salary = salaryText(job.salary_min, job.salary_max, job.salary_interval)
// Pagefind salary meta must be comparable across jobs, but salary_interval is
// 'YEAR' | 'HOUR' — an untouched $30/hour would lose to a "min $50,000" filter
// even though it annualizes to ~$62k. 2087 is the federal standard annual work
// hours factor (5 U.S.C. 5504(b)).
const annualize = (n: number) => Math.round(job.salary_interval === 'HOUR' ? n * 2087 : n)
const employerHub = job.employer_type === 'federal' ? `/agency/${kebab(job.employer)}` : `/company/${kebab(job.employer)}`
const metaDesc = `${tierLabel(job.location_policy)} ${job.employer_type === 'federal' ? 'federal' : 'contractor'} job at ${job.employer}${salary ? `, ${salary}` : ''}. Apply on the original posting.`
const resumeKeywords = extractKeywords(job.description_html)
const isFederal = job.employer_type === 'federal'
---
<Base title={`${job.title} — ${job.employer} (Remote)`} description={metaDesc}>
  <script type="application/ld+json" set:html={jobPostingJsonLd(job, Astro.site!.href.replace(/\/$/, ''))} slot="head" />
  <!--
    data-pagefind-body scopes the search index to job pages only. Pagefind
    indexes every built page by default; the moment any page carries this
    attribute, indexing becomes opt-in site-wide, so guides, category/agency
    hubs, the homepage and /search itself drop out of "Search Jobs" results.
    The wrapper must enclose every data-pagefind-filter / data-pagefind-meta
    element below plus the searchable copy — <main> lives in Base.astro, so a
    plain (visually inert) div is used here. The resume checker and the closing
    CTA sit outside it: boilerplate repeated on all 3.7k pages, not content.
  -->
  <div data-pagefind-body>
    {/* data-pagefind-ignore drops an element's TEXT from the index (so search
        excerpts start at the real description instead of badge/facts
        boilerplate) while filters/meta tagged inside are still processed —
        documented Pagefind behavior. The employer line below stays indexed on
        purpose: "search by agency or company" needs the name as free text. */}
    <p class="meta on-ground" style="margin-bottom:0.4rem;" data-pagefind-ignore>
      <span class={`badge ${job.location_policy}`} data-pagefind-filter={`location:${job.location_policy}`}>{tierLabel(job.location_policy)}</span>
      <span class={`badge ${job.employer_type}`} data-pagefind-filter={`type:${job.employer_type}`}>{job.employer_type === 'federal' ? 'Federal' : 'Contractor'}</span>
    </p>
    {/* h1 is ignored (its text would otherwise lead every excerpt, duplicating
        the card's own title line), so the title meta is set explicitly. */}
    <h1 data-pagefind-ignore data-pagefind-filter={`employer:${job.employer}`} data-pagefind-meta={`title:${job.title}`}>{job.title}</h1>
    <p class="meta" style="margin-bottom:1.2rem;">
      <a href={employerHub}>{job.employer}</a>{job.department && ` · ${job.department}`}
    </p>
    {job.category_name && <p data-pagefind-ignore data-pagefind-filter={`category:${job.category_name}`} style="display:none;">{job.category_name}</p>}
    {/* != null, not truthiness: Astro renders a bare 0 from a falsy guard, and a
        legitimate $0 lower bound would both paint a stray "0" into the page and
        drop the meta the salary filter needs. */}
    {job.salary_min != null && <p data-pagefind-meta={`salary_min:${annualize(job.salary_min)}`} style="display:none;"></p>}
    {job.salary_max != null && <p data-pagefind-meta={`salary_max:${annualize(job.salary_max)}`} style="display:none;"></p>}
    {/* Display strings for search result cards. */}
    {salary && <p data-pagefind-meta={`salary:${salary}`} style="display:none;"></p>}
    <p data-pagefind-meta={`posted:${dateText(job.posted_at)}`} style="display:none;"></p>

    {/* Ad unit 1: under the job header, above the facts card. Never between the
        facts box and the Apply button (Phase F hard rule). */}
    <AdSlot slot="job-header" />

    <div class="card" data-pagefind-ignore>
      <dl class="facts">
        {salary && <><dt>Salary</dt><dd>{salary}</dd></>}
        {job.grade_low && <><dt>Grade</dt><dd>{job.grade_low}{job.grade_high && job.grade_high !== job.grade_low ? `–${job.grade_high}` : ''}</dd></>}
        <dt>Work location</dt><dd>{tierLabel(job.location_policy)} (US)</dd>
        {job.employment_type && <><dt>Schedule</dt><dd>{job.employment_type}</dd></>}
        <dt>Posted</dt><dd>{dateText(job.posted_at)}</dd>
        {job.closes_at && <><dt>Apply by</dt><dd>{dateText(job.closes_at)}</dd></>}
        {job.category_name && <><dt>Category</dt><dd>{job.category_name}</dd></>}
      </dl>
      <p style="margin-top:1rem;">
        <a class="btn" href={job.apply_url} rel="nofollow noopener" target="_blank">{applyLabel(job.employer_type)} →</a>
      </p>
      <p class="meta" style="margin-top:0.5rem;">Source: {sourceLabel(job.employer_type, job.employer)}. Applications happen on the original posting, not on this site.</p>
    </div>

    <article class="description" set:html={job.description_html} />
  </div>

  {/* Ad unit 2: after the description, before the resume checker. */}
  <AdSlot slot="job-footer" />

  <section class="card resume-check" id="resume-check">
    <h2 style="margin-top:0;">Check your resume against this job</h2>
    <p class="meta">Rule-based, on-device analysis — your resume text is never sent to our servers or stored anywhere. Not a substitute for professional resume review.</p>
    <form id="resume-check-form">
      <textarea id="resume-text" rows="8" placeholder="Paste your resume text here…" aria-label="Your resume text"></textarea>
      <button type="submit" class="btn">Analyze</button>
    </form>
    <div id="resume-check-results" hidden></div>
  </section>

  <script type="application/json" id="job-keywords" set:html={JSON.stringify({ keywords: resumeKeywords, isFederal })} />
  <script>
    import { analyzeResume } from '../../lib/resume-match.ts'

    const dataEl = document.getElementById('job-keywords')
    const payload = dataEl?.textContent ? JSON.parse(dataEl.textContent) : { keywords: [], isFederal: false }
    const keywords: string[] = payload.keywords ?? []
    const isFederal: boolean = payload.isFederal ?? false

    const form = document.getElementById('resume-check-form')
    const textarea = document.getElementById('resume-text') as HTMLTextAreaElement | null
    const results = document.getElementById('resume-check-results')

    function chip(text: string, cls: string): HTMLSpanElement {
      const span = document.createElement('span')
      span.className = `kw-chip ${cls}`
      span.textContent = text
      return span
    }

    form?.addEventListener('submit', (e) => {
      e.preventDefault()
      if (!textarea || !results) return
      const text = textarea.value.trim()
      if (!text) return
      const analysis = analyzeResume(text, keywords, isFederal)

      results.innerHTML = ''
      results.hidden = false

      if (analysis.score >= 0) {
        const p = document.createElement('p')
        p.className = 'resume-score'
        p.textContent = `Keyword match: ${analysis.score}% (${analysis.matched.length}/${keywords.length})`
        results.appendChild(p)
      }

      if (analysis.matched.length) {
        const h = document.createElement('h3')
        h.textContent = 'Found in your resume'
        results.appendChild(h)
        const wrap = document.createElement('div')
        wrap.className = 'kw-wrap'
        analysis.matched.forEach((k) => wrap.appendChild(chip(k, 'kw-found')))
        results.appendChild(wrap)
      }

      if (analysis.missing.length) {
        const h = document.createElement('h3')
        h.textContent = 'Consider adding (if applicable)'
        results.appendChild(h)
        const wrap = document.createElement('div')
        wrap.className = 'kw-wrap'
        analysis.missing.forEach((k) => wrap.appendChild(chip(k, 'kw-missing')))
        results.appendChild(wrap)
      }

      if (analysis.tips.length) {
        const h = document.createElement('h3')
        h.textContent = 'Suggestions'
        results.appendChild(h)
        const ul = document.createElement('ul')
        analysis.tips.forEach((t) => {
          const li = document.createElement('li')
          li.textContent = t
          ul.appendChild(li)
        })
        results.appendChild(ul)
      }
    })
  </script>

  <div class="card" style="margin-top:1.5rem;">
    <p><a class="btn" href={job.apply_url} rel="nofollow noopener" target="_blank">{applyLabel(job.employer_type)} →</a></p>
    <p class="meta" style="margin-top:0.5rem;">More like this: <a href={employerHub}>{job.employer}</a> · <a href={`/${job.location_policy}`}>{tierLabel(job.location_policy)} jobs</a></p>
  </div>
</Base>
