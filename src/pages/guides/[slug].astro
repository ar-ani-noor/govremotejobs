---
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'

export async function getStaticPaths() {
  const guides = await getCollection('guides')
  return guides.map((g) => ({ params: { slug: g.id }, props: { guide: g } }))
}
const { guide } = Astro.props
const { Content } = await render(guide)
---
<Base title={`${guide.data.title} — GovRemoteJobs Guides`} description={guide.data.description}>
  <h1>{guide.data.title}</h1>
  <article class="description">
    <Content />
  </article>
  {guide.data.relatedHubs.length > 0 && (
    <div class="card" style="margin-top:1.5rem;">
      <h2 style="margin-top:0;font-size:1rem;">Related listings</h2>
      <p class="meta">
        {guide.data.relatedHubs.map((h, i) => (
          <>{i > 0 && ' · '}<a href={h.href}>{h.label}</a></>
        ))}
      </p>
    </div>
  )}
  <p style="margin-top:1.5rem;"><a href="/guides">← All guides</a></p>
</Base>
